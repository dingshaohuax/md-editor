---
import Demo from "../components/demo";

const homeHref = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>组件演示 | md-editor</title>

		<style>
			body {
				display: flex;
				flex-direction: column;
				height: 100vh;
				height: 100dvh;
				margin: 0;
				background: radial-gradient(ellipse at top, #e9f2ff, transparent 34rem) #f5f7fb;
				color: #152541;
				font: 1rem/1.5 system-ui, sans-serif;
			}

			.page-width {
				width: min(calc(100% - 2rem), 60rem);
				margin-inline: auto;
			}

			.topbar {
				flex: none;
				border-bottom: 1px solid #dfe7f1;
				background: rgb(255 255 255 / 90%);
			}

			.topbar-inner {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				min-height: 3.75rem;
			}

			.project-name {
				color: #1559bf;
				font-weight: 700;
				white-space: nowrap;
			}

			.topbar-actions {
				display: flex;
				align-items: center;
				gap: 0.625rem;
				min-width: 0;
			}


			.back-link {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				flex: none;
				white-space: nowrap;
				padding: 0.35rem 0.65rem;
				border-radius: 0.375rem;
				color: #344761;
				font-size: 0.875rem;
				text-decoration: none;
			}

			.back-link:hover {
				background: #edf4ff;
				color: #1559bf;
			}

			.back-link:focus-visible {
				outline: 2px solid #1765d8;
				outline-offset: 2px;
			}

			.topbar :global(.playground-save-controls) {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				min-width: 0;
			}

			.topbar :global(.playground-save-status) {
				color: #526783;
				font-size: 0.75rem;
				line-height: 1.3;
				white-space: nowrap;
			}

			.topbar :global(.playground-save-status:empty) {
				position: absolute;
			}

			.topbar :global(.playground-save-button) {
				display: inline-flex;
				flex: none;
				align-items: center;
				justify-content: center;
				gap: 0.375rem;
				min-height: 2.25rem;
				padding-inline: 0.75rem;
				border: 1px solid #1559bf;
				border-radius: 0.5rem;
				background: #1559bf;
				color: #fff;
				box-shadow: 0 1px 2px rgb(21 37 65 / 14%);
				font: inherit;
				font-size: 0.875rem;
				font-weight: 600;
				line-height: 1;
				white-space: nowrap;
				cursor: pointer;
			}

			.topbar :global(.playground-save-button:hover:not(:disabled)) {
				border-color: #124ca4;
				background: #124ca4;
			}

			.topbar :global(.playground-save-button:focus-visible) {
				outline: 2px solid #1765d8;
				outline-offset: 2px;
			}

			.topbar :global(.playground-save-button:disabled) {
				border-color: #cadcf4;
				background: #e9f1fc;
				color: #456286;
				box-shadow: none;
				cursor: default;
			}

			.topbar :global(.playground-save-button svg) {
				flex: none;
				width: 1rem;
				height: 1rem;
			}

			@media (max-width: 34rem) {
				.topbar-inner,
				.topbar-actions {
					gap: 0.375rem;
				}

				.topbar :global(.playground-save-controls) {
					flex-direction: column-reverse;
					align-items: flex-end;
					gap: 0.125rem;
					padding-block: 0.1875rem;
				}

				.topbar :global(.playground-save-status) {
					max-width: 8rem;
					text-align: right;
					white-space: normal;
				}
			}


			.playground {
				display: flex;
				flex: 1;
				flex-direction: column;
				min-height: 0;
				padding-block: 2rem;
			}

			.playground :global(.demo-card) {
				min-width: 0;
				padding: clamp(1rem, 3vw, 1.5rem);
				border: 1px solid #dfe7f1;
				border-radius: 1rem;
				background: #fff;
				box-shadow: 0 6px 20px rgb(21 37 65 / 5%);
			}

			.playground :global(.demo-card-heading) {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 0.75rem;
				margin-bottom: 1rem;
			}

			.playground :global(.demo-card-heading h2) {
				margin: 0;
				font-size: 1.125rem;
			}

			.playground :global(.demo-card-heading code) {
				color: #5a6d87;
				font-size: 0.8125rem;
			}

			.playground :global(.demo-preview) {
				box-sizing: border-box;
				display: grid;
				align-items: center;
				min-height: 8rem;
				padding: 1rem;
				border: 1px solid #e8eef6;
				border-radius: 0.625rem;
				background: #f8fafd;
			}

			.playground :global(.demo-buttons) {
				display: flex;
				flex-wrap: wrap;
				gap: 0.625rem;
			}

			.playground :global(.demo-field) {
				display: grid;
				gap: 0.4rem;
				width: min(100%, 17rem);
				font-size: 0.875rem;
				font-weight: 500;
			}
		</style>
	</head>
	<body>
		<header class="topbar">
			<div class="page-width topbar-inner">
				<span class="project-name">md-editor</span>
				<div class="topbar-actions">
					<a class="back-link" href={homeHref}>
						<span aria-hidden="true">←</span>
						返回文档
					</a>
					<div id="playground-save-controls"></div>
				</div>
			</div>
		</header>
		<main class="page-width playground">
			<Demo client:load />
		</main>
	</body>
</html>
